# BHT Marketing Planner - Environment Variables Configuration
# Copy this file to .env.local and fill in the actual values

# Turso Database Connection URL
# This is the libsql:// URL for your Turso database instance
# Obtain this by running: turso db show bht-marketing-planner --url
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Turso Authentication Token
# This token is required to authenticate with your Turso database
# Obtain this by running: turso db tokens create bht-marketing-planner
# Keep this secret - never commit it to version control
TURSO_AUTH_TOKEN=your_auth_token_here
